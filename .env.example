# Copy this file to .env and fill in real values. mqtt_to_mysql.py loads it
# automatically on startup (via python-dotenv) if it's present. .env itself
# is git-ignored so credentials never get committed.

# --- MQTT broker (the same one the esp32-c3-bridge is configured to publish to) ---
MQTT_HOST=cits1.opentrafficmap.org
MQTT_PORT=8883
MQTT_TLS=true
# Matches the bridge firmware's default (mqtt_insecure=true): skip TLS cert
# verification. Set to false if your broker has a certificate you can verify.
MQTT_INSECURE=true
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=its

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=its_bridge
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=its_bridge

LOG_LEVEL=INFO
